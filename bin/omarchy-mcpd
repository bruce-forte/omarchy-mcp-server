#!/bin/bash
#
# Starts the Omarchy MCP daemon, building whatever it needs first.
#
# `omarchy plugin add` clones the repository and copies files. It runs no build
# and no install hook, by design -- the installer will not execute plugin code
# before you have enabled it. So the environment has to be built lazily, here,
# on first run.
#
# Everything this creates lives in the state directory. Nothing is ever written
# inside the plugin directory: Omarchy watches it and reloads the shell on any
# write, so a plugin that writes to itself reloads the shell every time it runs.

set -euo pipefail

PLUGIN_ID="io.github.bruce-forte.mcp-server"
# ${BASH_SOURCE[0]%/*} is `dirname` without spawning one, and `cd -P` resolves
# symlinks with a builtin. Nothing may be executed before the library that vets
# executables has been loaded -- including the thing that works out where it is.
PLUGIN_DIR="$(cd -P -- "${BASH_SOURCE[0]%/*}/.." && pwd)"

# Which files this script is willing to run. Sourced before anything is spawned;
# see the header of that file for the rule and for why it is duplicated in
# `src/omarchy_mcp/trust.py`.
source "$PLUGIN_DIR/bin/omarchy-mcp-trust"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$PLUGIN_ID"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/mcp"
VENV="$STATE_DIR/venv"
STAMP="$STATE_DIR/bootstrap.stamp"
UV_BIN_DIR="$STATE_DIR/bin"

# Downloaded at a pinned version and verified, rather than through the upstream
# one-line installer. This plugin gets installed by other people, and fetching
# an unpinned script from a third-party host would run whatever that host
# happens to be serving at the moment they install it.
UV_VERSION="0.9.29"

#: SHA-256 of each supported uv release archive at UV_VERSION.
#
# These are committed here, in the source a reviewer reads, and that is the
# whole point of them. The previous version fetched `<archive>.sha256` from the
# same GitHub release and checked against that, which authenticates nothing:
# release assets are mutable, so whoever can replace the archive can replace
# the checksum lying beside it, and the check passes on both. A constant in
# reviewed source cannot be replaced without a commit somebody signed off on.
#
# Bumping UV_VERSION means transcribing both of these again. Verify them
# against more than the release page if you can -- that is the only step that
# makes this an independent check rather than a longer way of trusting the same
# host.
UV_SHA256_X86_64="1ce5212f8f42dc7427a1bd3db4168d6d1abcf81b38d8c82a5b9d0ddc54ceebfc"
UV_SHA256_AARCH64="935b35542b7e25493a551dcb3487af23b72ad284ee8ac6a488a97d02ce2d84ec"

#: What is accepted from the network, and out of the archive.
#
# The pinned checksum already fixes the size of a legitimate archive, so these
# never fire on a good download. They exist so that the failure mode of a
# careless version bump -- a new constant, transcribed from a release that has
# been tampered with -- is a refusal rather than a full disk, and so that
# nothing enormous is written before any check has run.
UV_ARCHIVE_MAX_BYTES=$((64 * 1024 * 1024))
UV_MEMBER_MAX_BYTES=$((192 * 1024 * 1024))
UV_MEMBERS_MAX=8
UV_DOWNLOAD_MAX_SECONDS=300

# The system interpreter, by absolute path. `python3` on PATH is frequently a
# mise, brew or conda shim, and building the venv against one of those makes the
# daemon stop working the moment that shim moves.
SYSTEM_PYTHON="/usr/bin/python3"

log()  { printf 'omarchy-mcpd: %s\n' "$*" >&2; }
fail() {
  log "$*"
  # Nowhere else reports this: the caller is a QML service and the user is
  # looking at a desktop, not a terminal.
  #
  # `${TRUSTED[omarchy]:-}` rather than the bare name: this can be reached
  # before binding has succeeded -- binding failing is one of the things it
  # reports -- and a failure path is the worst place to resolve a command on an
  # unchecked PATH. With nothing bound the notification is skipped and stderr
  # still carries it.
  if [[ -n ${TRUSTED[omarchy]:-} ]]; then
    "${TRUSTED[omarchy]}" notification send -u critical "Omarchy MCP server" "$*" 2>/dev/null || true
  fi
  exit 1
}

#: Every external command this script runs. Named in one place so that a new
#: spawn has to be declared here, where it is checked, rather than appearing as
#: a bare word somewhere further down.
TRUST_NEEDS=(
  omarchy uname mktemp curl stat sha256sum cut tar grep awk sort wc
  install mv rm mkdir cp
)

trust_bind "${TRUST_NEEDS[@]}" || {
  log "refusing to start: the commands this bootstrap needs could not be verified"
  exit 1
}

# Children look their own helpers up on this, not on the session PATH.
PATH="$(trust_path)"
export PATH

# A uv this script is willing to execute: a regular file, not a symlink, and
# executable. `-f` is true for a symlink pointing at a regular file, so the
# `-L` test is not redundant -- it is what stops anything that can write into
# the state directory from redirecting the interpreter build at another binary.
usable_uv() {
  local candidate="$1"
  [[ -n $candidate ]] && [[ ! -L $candidate ]] && [[ -f $candidate ]] && [[ -x $candidate ]]
}

find_uv() {
  local found
  # A system uv, resolved against the allowlist and verified like anything else.
  #
  # This used to be `command -v uv`, which reads the session PATH -- so a `uv`
  # in any directory that PATH happened to name was executed to build the
  # interpreter this daemon runs on, ahead of every check in this file. That is
  # the hole the marketplace review found; see ROADMAP N20.
  if found="$(trust_resolve uv 2>/dev/null)" && [[ -n $found ]]; then
    printf '%s\n' "$found"
    return 0
  fi
  # The copy this script installed. It lives in the state directory, which the
  # user owns by necessity, so it cannot be root-owned and is not checked for
  # that. What stands behind it instead is how it got there: a pinned archive,
  # a digest committed in this file, and the inspection in verify_uv_archive.
  if usable_uv "$UV_BIN_DIR/uv"; then
    printf '%s\n' "$UV_BIN_DIR/uv"
    return 0
  fi
  return 1
}

# Decide whether a downloaded archive may be unpacked at all.
#
# Split out from install_uv so that it can be exercised without a network: the
# test suite builds hostile archives in a temporary directory and calls this
# directly. Everything here runs *before* tar writes anything, because a
# checksum says the bytes are the ones upstream published and says nothing
# about what tar would do with them.
#
#   $1 archive path   $2 expected top-level directory   $3 expected sha256
verify_uv_archive() {
  local archive="$1" dir="$2" want="$3"
  local size got listing names expected

  size="$("${TRUSTED[stat]}" -c %s -- "$archive")"
  [[ $size -gt 0 && $size -le $UV_ARCHIVE_MAX_BYTES ]] \
    || fail "the downloaded uv archive is $size bytes, which is outside what this plugin accepts"

  # Against the constant committed above, never against a checksum fetched
  # from the host that served the archive.
  got="$("${TRUSTED[sha256sum]}" -- "$archive" | "${TRUSTED[cut]}" -d' ' -f1)"
  [[ $got == "$want" ]] \
    || fail "uv $UV_VERSION does not match the checksum committed in this plugin; refusing to run it"

  listing="$("${TRUSTED[tar]}" -tvzf "$archive")" \
    || fail "the downloaded uv archive could not be read"

  [[ "$(printf '%s\n' "$listing" | "${TRUSTED[wc]}" -l)" -le $UV_MEMBERS_MAX ]] \
    || fail "the uv archive has more members than this plugin accepts"

  # tar -tv prints the entry type as the first character of the mode. Anything
  # but a regular file (-) or a directory (d) -- a symlink (l), a hard link
  # (h), a device (b, c), a fifo (p) -- is not the shape upstream publishes,
  # and tar can follow a link out of the extraction directory.
  if printf '%s\n' "$listing" | "${TRUSTED[grep]}" -qvE '^[-d]'; then
    fail "the uv archive contains a link or a special file; refusing to unpack it"
  fi

  # Field 3 of GNU tar's verbose listing is the size. A member over the bound
  # is refused before a byte of it is written.
  #
  # shellcheck disable=SC2016  # $3 and max are awk's, not the shell's; expanding
  # them here is exactly what must not happen.
  if ! printf '%s\n' "$listing" | "${TRUSTED[awk]}" -v max="$UV_MEMBER_MAX_BYTES" \
       '$3 !~ /^[0-9]+$/ || $3 > max { exit 1 }'; then
    fail "the uv archive contains an oversized or unreadable member"
  fi

  # An allowlist, not a denylist. Requiring the member names to be exactly
  # these three covers traversal (`..`), absolute paths, and anything
  # unexpected, in one comparison rather than three patterns that each have to
  # be right on their own.
  names="$("${TRUSTED[tar]}" -tzf "$archive" | LC_ALL=C "${TRUSTED[sort]}")"
  expected="$(printf '%s\n' "$dir/" "$dir/uv" "$dir/uvx" | LC_ALL=C "${TRUSTED[sort]}")"
  [[ $names == "$expected" ]] \
    || fail "the uv archive does not contain exactly the files this plugin expects"
}

install_uv() {
  local arch tarball dir url tmp want size staged binary

  arch="$("${TRUSTED[uname]}" -m)"
  case "$arch" in
    x86_64)  tarball="uv-x86_64-unknown-linux-gnu.tar.gz";  want="$UV_SHA256_X86_64" ;;
    aarch64) tarball="uv-aarch64-unknown-linux-gnu.tar.gz"; want="$UV_SHA256_AARCH64" ;;
    *) fail "unsupported architecture $arch; install uv yourself (sudo pacman -S uv)" ;;
  esac
  # The archive unpacks into one directory named after itself.
  dir="${tarball%.tar.gz}"

  url="https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/${tarball}"
  tmp="$("${TRUSTED[mktemp]}" -d)"
  trap '"${TRUSTED[rm]}" -rf "$tmp"' RETURN

  log "downloading uv $UV_VERSION"
  # --proto '=https' refuses a redirect to any other scheme, which -L would
  # otherwise follow. --max-filesize refuses a body whose declared length is
  # over the bound before any of it is written.
  "${TRUSTED[curl]}" -fsSL --proto '=https' --tlsv1.2 \
    --retry 3 --retry-delay 2 --max-time "$UV_DOWNLOAD_MAX_SECONDS" \
    --max-filesize "$UV_ARCHIVE_MAX_BYTES" \
    -o "$tmp/uv.tar.gz" "$url" \
    || fail "could not download uv. Check your network, or install it with: sudo pacman -S uv"

  verify_uv_archive "$tmp/uv.tar.gz" "$dir" "$want"

  # Only the one member is extracted, into a directory of its own, and without
  # taking the archive's ownership or permission bits.
  "${TRUSTED[mkdir]}" -p "$tmp/x"
  "${TRUSTED[tar]}" -xzf "$tmp/uv.tar.gz" -C "$tmp/x" --no-same-owner --no-same-permissions \
    -- "$dir/uv" \
    || fail "could not unpack uv"

  # Verify what came out, rather than what the listing promised.
  binary="$tmp/x/$dir/uv"
  usable_uv "$binary" || fail "the unpacked uv is not a regular executable file"
  size="$("${TRUSTED[stat]}" -c %s -- "$binary")"
  [[ $size -gt 0 && $size -le $UV_MEMBER_MAX_BYTES ]] \
    || fail "the unpacked uv is $size bytes, which is outside what this plugin accepts"

  # Staged beside its destination and renamed onto it. Same directory means the
  # same filesystem, so the rename is atomic: nothing ever executes a
  # half-written uv, and a failure part-way leaves the previous one in place.
  "${TRUSTED[mkdir]}" -p "$UV_BIN_DIR"
  staged="$UV_BIN_DIR/.uv.$$"
  "${TRUSTED[install]}" -m 0755 -- "$binary" "$staged" || fail "could not install uv"
  "${TRUSTED[mv]}" -f -- "$staged" "$UV_BIN_DIR/uv" || { "${TRUSTED[rm]}" -f -- "$staged"; fail "could not install uv"; }

  usable_uv "$UV_BIN_DIR/uv" || fail "uv did not survive installation"
  printf '%s\n' "$UV_BIN_DIR/uv"
}

seed_config() {
  # Seeded on every start, not only when the venv is built, so deleting the file
  # gets it back. Never overwritten: the copy in the config directory is yours.
  [[ -f $CONFIG_DIR/config.toml ]] && return 0
  "${TRUSTED[mkdir]}" -p "$CONFIG_DIR"
  "${TRUSTED[cp]}" "$PLUGIN_DIR/config.example.toml" "$CONFIG_DIR/config.toml"
  log "wrote $CONFIG_DIR/config.toml"
}

# The venv is rebuilt when the lockfile, the interpreter, or this script change.
want_stamp() {
  printf '%s\n' \
    "uv=$UV_VERSION" \
    "python=$("$SYSTEM_PYTHON" -c 'import sys;print(sys.version.split()[0])' 2>/dev/null || echo none)" \
    "lock=$("${TRUSTED[sha256sum]}" "$PLUGIN_DIR/uv.lock" 2>/dev/null | "${TRUSTED[cut]}" -d' ' -f1)" \
    "wrapper=$("${TRUSTED[sha256sum]}" "${BASH_SOURCE[0]}" | "${TRUSTED[cut]}" -d' ' -f1)"
}

ensure_venv() {
  local uv
  if [[ -x $VENV/bin/python ]] && [[ -f $STAMP ]] \
     && [[ "$(<"$STAMP")" == "$(want_stamp)" ]]; then
    return 0
  fi

  [[ -x $SYSTEM_PYTHON ]] || fail "$SYSTEM_PYTHON is missing; Omarchy expects a system Python"

  uv="$(find_uv || true)"
  if [[ -z $uv ]]; then
    uv="$(install_uv)"
  fi
  # Checked here as well as at installation, because find_uv may have returned
  # one installed on an earlier run, and this is the line before it is executed.
  usable_uv "$uv" || fail "no usable uv; install it with: sudo pacman -S uv"

  log "building the environment in $VENV"
  "${TRUSTED[mkdir]}" -p "$STATE_DIR"
  # UV_PROJECT_ENVIRONMENT puts the venv in the state directory instead of the
  # plugin directory. That is not a preference: `omarchy plugin validate`
  # rejects symlinks inside a plugin folder, and a venv is made of them.
  #
  # --python by absolute path, or uv fetches a CPython of its own.
  # --frozen installs exactly the locked versions and never resolves.
  # --no-install-project because this project is never installed: an editable
  # install writes build artifacts into the plugin directory, and Omarchy
  # reloads the shell on any write there.
  UV_PROJECT_ENVIRONMENT="$VENV" "$uv" sync \
    --frozen --no-dev --no-install-project \
    --project "$PLUGIN_DIR" --python "$SYSTEM_PYTHON" >&2 \
    || fail "could not install dependencies. Check your network, then run: omarchy-shell $PLUGIN_ID rebuild"

  want_stamp > "$STAMP"
  log "environment ready"
}

case "${1:-}" in
  --rebuild) "${TRUSTED[rm]}" -rf "$VENV" "$STAMP"; shift ;;
  # Remove the environment and stop. The bar panel's Rebuild button used to do
  # this itself, with a bare `rm -rf` and its own idea of where the venv lives;
  # both of those belong here.
  --rebuild-only)
    "${TRUSTED[rm]}" -rf "$VENV" "$STAMP"
    log "removed $VENV"
    exit 0
    ;;
esac

seed_config
ensure_venv

# PYTHONPATH rather than an install, for the reason in ensure_venv.
#
# PYTHONPYCACHEPREFIX is not optional. Python writes __pycache__ next to the
# source it imports, and the source lives in the plugin directory, which
# Omarchy watches -- so without this every fresh interpreter start writes
# bytecode into a watched directory and makes the shell reload itself. The
# cache is still kept, just in the state directory where it belongs.
# `export` and a plain exec rather than `env`: one less executable to resolve on
# the last line of the bootstrap. The interpreter is named absolutely and is the
# one this script built.
export PYTHONPATH="$PLUGIN_DIR/src"
export PYTHONPYCACHEPREFIX="$STATE_DIR/pycache"
exec "$VENV/bin/python" -m omarchy_mcp "$@"
