#!/bin/bash
#
# Records an answer to an approval request.
#
# Two surfaces call this, and that is the point of it existing at all:
#
#   approve     <token>   the notification's --exec, when the user clicks it
#   always      <token>   the bar panel's Always button
#   deny        <token>   the bar panel's Deny button
#   acknowledge <token>   the bar panel's Acknowledge button, for a review
#   prune       <token>   the bar panel's Prune button, for dead rules
#   revoke      <token> <effect> <matcher>
#                         the bar panel's Remove button, for one grant
#
# `acknowledge` answers a different question -- "I have seen what changed" rather
# than "yes, run this" -- but it travels the same way and for the same reason.
# Acknowledging is silent by design: it consumes a warning and raises nothing. An
# agent able to do it could clear its own review with nothing on screen, so the
# token is minted by the daemon, published only on the frame the shell reads, and
# never given to the model.
#
# A notification carries exactly one action, so it can say yes and nothing else.
# The panel has room for the other two. Both write here rather than either one
# writing the file itself: this is the whole answer channel, so it stays small,
# it validates what it is given, and there is one place the vocabulary is
# defined. Business rules do not move into the UI layer.
#
# The token is the filename *and* the first word of the contents: the daemon
# accepts only when both match, which is what stops a file that happens to exist
# from counting as a yes. A verb never excuses a wrong token.
#
# Nothing here writes inside the plugin directory. The token lands in the
# runtime directory and dies with the session, which is right -- an approval
# that outlived the desktop it was granted on would be a stale yes.

set -euo pipefail

PLUGIN_ID="io.github.bruce-forte.mcp-server"
CONSENT_DIR="${XDG_RUNTIME_DIR:-/tmp}/$PLUGIN_ID/consent"

# This is the whole answer channel, and the bar panel spawns it. It runs two
# external commands; both are resolved against the allowlist rather than the
# session PATH, for the reason in `bin/omarchy-mcp-trust`. An answer recorded by
# somebody else's `mktemp` is not an answer.
PLUGIN_DIR="$(cd -P -- "${BASH_SOURCE[0]%/*}/.." && pwd)"
source "$PLUGIN_DIR/bin/omarchy-mcp-trust"
trust_bind mkdir mktemp || {
  echo "omarchy-mcp-consent: refusing to run: mkdir or mktemp could not be verified" >&2
  exit 1
}
PATH="$(trust_path)"
export PATH

usage() {
  echo "usage: omarchy-mcp-consent {approve|always|deny|acknowledge|prune} <token>" >&2
  echo "       omarchy-mcp-consent revoke <token> <effect> <matcher>" >&2
  exit 2
}

# `revoke` is the one verb that names something: the others answer a question
# the daemon already knows the subject of, and this one picks a rule out of a
# list. What it may mean is still decided in permissions.py -- this validates
# the shape and nothing else.
if [[ ${1:-} == revoke ]]; then
  [[ $# -eq 4 ]] || usage
else
  [[ $# -eq 2 ]] || usage
fi

# `approve` is spelled that way in every notification this daemon has ever sent,
# including ones already on screen when it was upgraded. It writes the bare
# token, which is what "once" has always meant on this channel.
case "$1" in
  approve) verb="" ;;
  always)  verb=" always" ;;
  deny)    verb=" deny" ;;
  # Not an answer to a prompt, so it lands under its own name rather than in a
  # pending call's file. The daemon looks for it on its poll.
  acknowledge) verb=""; marker="ack" ;;
  # Pruning removes rules that grant nothing -- they match no command -- so it
  # cannot widen what an agent may do. It can still erase evidence: a dead
  # `deny` somebody hand-added to this file is a protection that stopped
  # working, and that is worth seeing before it is tidied away.
  prune)       verb=""; marker="prune" ;;
  # Removing a grant only ever narrows what an agent may do, so the token is
  # long-lived rather than spent per press. That makes the *file name* the thing
  # that has to be unique: two presses inside one poll would otherwise collapse,
  # the second overwriting the first, and a rule the user removed would quietly
  # stay. One file per press, drained in order.
  revoke)      verb="" ;;
  *)       usage ;;
esac

token="$2"

# The token is generated by the daemon with secrets.token_urlsafe, so its
# alphabet is known exactly. Refusing anything else keeps a path separator or a
# `..` out of the filename below, whatever ends up able to invoke this.
[[ $token =~ ^[A-Za-z0-9_-]{16,64}$ ]] || {
  echo "omarchy-mcp-consent: not a token" >&2
  exit 2
}

# 0700 on the directory and 0600 on the file: an approval is a capability for
# as long as it sits there, and the daemon deletes it as soon as it reads it.
umask 077
"${TRUSTED[mkdir]}" -p "$CONSENT_DIR"
if [[ $1 == revoke ]]; then
  effect="$3"
  matcher="$4"
  # The vocabulary lives here, in one place, as it does for the verbs above. A
  # daemon that has not heard of an effect must read this as no answer.
  case "$effect" in
    allow|ask|deny) ;;
    *) echo "omarchy-mcp-consent: not an effect" >&2; exit 2 ;;
  esac
  # Shape only: a route is words, spaces and a trailing star. Whether this rule
  # exists, is in the right file, and may go is the daemon's decision.
  [[ $matcher =~ ^[A-Za-z0-9][A-Za-z0-9_.:-]*([[:space:]][A-Za-z0-9_.:*-]+)*$ ]] || {
    echo "omarchy-mcp-consent: not a matcher" >&2
    exit 2
  }
  file=$("${TRUSTED[mktemp]}" "$CONSENT_DIR/revoke-$token.XXXXXX")
  printf '%s revoke %s %s' "$token" "$effect" "$matcher" >"$file"
elif [[ -n ${marker:-} ]]; then
  printf '%s' "$token" >"$CONSENT_DIR/$marker-$token"
else
  printf '%s%s' "$token" "$verb" >"$CONSENT_DIR/$token"
fi
