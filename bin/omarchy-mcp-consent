#!/bin/bash
#
# Records an answer to an approval request.
#
# Two surfaces call this, and that is the point of it existing at all:
#
#   approve     <token>   the notification's --exec, when the user clicks it
#   always      <token>   the bar panel's Always button
#   deny        <token>   the bar panel's Deny button
#   acknowledge <token>   the bar panel's Acknowledge button, for a review
#
# `acknowledge` answers a different question -- "I have seen what changed" rather
# than "yes, run this" -- but it travels the same way and for the same reason.
# Acknowledging is silent by design: it consumes a warning and raises nothing. An
# agent able to do it could clear its own review with nothing on screen, so the
# token is minted by the daemon, published only on the frame the shell reads, and
# never given to the model.
#
# A notification carries exactly one action, so it can say yes and nothing else.
# The panel has room for the other two. Both write here rather than either one
# writing the file itself: this is the whole answer channel, so it stays small,
# it validates what it is given, and there is one place the vocabulary is
# defined. Business rules do not move into the UI layer.
#
# The token is the filename *and* the first word of the contents: the daemon
# accepts only when both match, which is what stops a file that happens to exist
# from counting as a yes. A verb never excuses a wrong token.
#
# Nothing here writes inside the plugin directory. The token lands in the
# runtime directory and dies with the session, which is right -- an approval
# that outlived the desktop it was granted on would be a stale yes.

set -euo pipefail

PLUGIN_ID="io.github.bruce-forte.mcp-server"
CONSENT_DIR="${XDG_RUNTIME_DIR:-/tmp}/$PLUGIN_ID/consent"

usage() {
  echo "usage: omarchy-mcp-consent {approve|always|deny|acknowledge} <token>" >&2
  exit 2
}

[[ $# -eq 2 ]] || usage

# `approve` is spelled that way in every notification this daemon has ever sent,
# including ones already on screen when it was upgraded. It writes the bare
# token, which is what "once" has always meant on this channel.
case "$1" in
  approve) verb="" ;;
  always)  verb=" always" ;;
  deny)    verb=" deny" ;;
  # Not an answer to a prompt, so it lands under its own name rather than in a
  # pending call's file. The daemon looks for it on its poll.
  acknowledge) verb=""; ack=1 ;;
  *)       usage ;;
esac

token="$2"

# The token is generated by the daemon with secrets.token_urlsafe, so its
# alphabet is known exactly. Refusing anything else keeps a path separator or a
# `..` out of the filename below, whatever ends up able to invoke this.
[[ $token =~ ^[A-Za-z0-9_-]{16,64}$ ]] || {
  echo "omarchy-mcp-consent: not a token" >&2
  exit 2
}

# 0700 on the directory and 0600 on the file: an approval is a capability for
# as long as it sits there, and the daemon deletes it as soon as it reads it.
umask 077
mkdir -p "$CONSENT_DIR"
if [[ ${ack:-0} -eq 1 ]]; then
  printf '%s' "$token" >"$CONSENT_DIR/ack-$token"
else
  printf '%s%s' "$token" "$verb" >"$CONSENT_DIR/$token"
fi
